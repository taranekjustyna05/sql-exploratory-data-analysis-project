/*
===============================================================================
Date Range Exploration 
===============================================================================
Purpose:
    - To determine the temporal boundaries of key data points.
    - To understand the range of historical data.
===============================================================================
*/

--Find the date of the first and last order
--How many year of sales are avaiable
SELECT 
MIN(order_date) AS first_order_date, 
MAX(order_date) AS last_order_date,
DATEDIFF(yy, MIN(order_date), MAX(order_date)) AS order_range_years
FROM gold.fact_sales

-- Find the youngest and the oldest customer
SELECT 
MIN(birthdate) AS the_oldest_customer,
DATEDIFF(yy, MIN(birthdate), GETDATE()) AS oldest_age,
MAX(birthdate) AS the_youngest_customer,
DATEDIFF(yy, MAX(birthdate), GETDATE()) AS youngest_age
FROM gold.dim_customers

